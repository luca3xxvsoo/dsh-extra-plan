{
  "name": "@local/dsh-extra-plan-settings",
  "description": "DSH settings UI: extra-plan pro planner config and qqbot approval toggle under Settings → Plugins.",
  "version": "0.1.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "files": [
    "index.js",
    "lib/client.js"
  ],
  "license": "MIT",
  "dependencies": {
    "js-yaml": "^4.2.0"
  }
}
