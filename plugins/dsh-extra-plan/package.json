{
  "name": "@local/dsh-extra-plan",
  "version": "0.3.0",
  "description": "实现权限控制+子代理角色分配",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./settings": "./lib/settings.js",
    "./settings/locale/*": "./locale/*",
    "./locale/*.json": "./locale/*.json",
    "./executor-spawn": "./lib/executor-spawn.js",
    "./preset-sync": "./lib/preset-sync.js",
    "./preset-sync/locale/*": "./locale/*",
    "./client": "./lib/client.js",
    "./client-bridge": "./lib/client-bridge.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./assets/presets/extra-plan/preset-patch.generated.yml": "./assets/presets/extra-plan/preset-patch.generated.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "locale/",
    "scripts/generate-runtime-defaults.mjs",
    "cordis.patch.yml",
    "assets/presets/extra-plan/",
    "assets/presets/extra-plan/preset-patch.generated.yml"
  ],
  "scripts": {
    "generate:runtime-defaults": "node scripts/generate-runtime-defaults.mjs",
    "prepack": "node scripts/generate-runtime-defaults.mjs"
  },
  "license": "MIT",
  "repository": "git+https://github.com/luca3xxvsoo/dsh-extra-plan.git",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./assets/presets/extra-plan/preset-patch.generated.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "dependencies": {
    "js-yaml": "^4.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.7-rc.1 || 0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1 || 0.1.7-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}
